generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id              String      @id @default(uuid())
  firstName       String
  lastName        String
  email           String      @unique
  deals           DealOwner[]
  incentives      Incentive[]
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
}

model Organization {
  id         String      @id @default(uuid())
  name       String
  employees  Employee[]
}

model Deal {
  id        String      @id @default(uuid())
  name      String
  value     Float
  closeDate DateTime
  owners    DealOwner[]
}

model DealOwner {
  id           String   @id @default(uuid())
  dealId       String
  employeeId   String
  percentage   Float

  deal         Deal     @relation(fields: [dealId], references: [id])
  employee     Employee @relation(fields: [employeeId], references: [id])
}

enum IncentiveStatus {
  ACTIVE
  DRAFT
  INACTIVE
}

enum IncentiveType {
  DEAL_PARTICIPATION
}

model Incentive {
  id                    String          @id @default(uuid())
  organizationId        String
  name                  String
  description           String?
  type                  IncentiveType   @default(DEAL_PARTICIPATION)
  commissionPercentage  Float
  startDate             DateTime
  endDate               DateTime?
  status                IncentiveStatus @default(DRAFT)

  beneficiaries         Employee[]

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([organizationId])
}