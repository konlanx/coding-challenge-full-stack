{
  "name": "backend",
  "version": "1.0.0",
  "description": "ExpressJS API server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch index.ts",
    "test": "vitest",
    "db:migrations:apply": "npx prisma generate",
    "db:migrations:generate": "npx prisma migrate dev --name",
    "db:seed": "npx tsx ./prisma/seed/seed.ts"
  },
  "packageManager": "yarn@4.12.0",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^25.0.9",
    "prettier": "^3.7.4",
    "prisma": "^7.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17"
  }
}